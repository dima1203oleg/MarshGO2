FROM node:24.21.0-alpine AS build
WORKDIR /app
ARG VITE_MAP_STYLE_MANIFEST_URL
ENV VITE_MAP_STYLE_MANIFEST_URL=${VITE_MAP_STYLE_MANIFEST_URL}
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
ARG MARSHGO_SOURCE_SHA=unknown
ARG MARSHGO_BUILD_ID=unknown
# The base image ships its own org.opencontainers.image.* labels; overriding them here is what makes
# `docker inspect` point at MarshGO-Site instead of at docker-nginx-unprivileged.
LABEL com.marshgo.git.sha="${MARSHGO_SOURCE_SHA}" \
      com.marshgo.build.id="${MARSHGO_BUILD_ID}" \
      org.opencontainers.image.title="marshgo/web" \
      org.opencontainers.image.source="https://github.com/dima1203oleg/MarshGO-Site" \
      org.opencontainers.image.revision="${MARSHGO_SOURCE_SHA}"
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
