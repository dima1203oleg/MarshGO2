{
  "name": "marshgo-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "site:checkout": "node scripts/checkout-site.mjs",
    "site:build": "npm run build --prefix web && npm run site:build-info",
    "site:build-info": "node scripts/write-build-info.mjs",
    "sync": "npx cap sync ios",
    "build:simulator": "bash scripts/build-ios-simulator.sh"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
